# README
RUN <<'EOF' cat > README
pg-status v1.6.1 (static build)
===============================

A microservice (sidecar) that helps instantly determine the status of your
PostgreSQL hosts including whether they are alive, which one is the master,
which ones are replicas, and how far each replica is lagging behind the master.

This is a statically linked binary with no external dependencies.

Licenses
--------
See LICENSE for the pg-status license.
See THIRD-PARTY-NOTICES and the licenses/ directory for third-party licenses.

Source Code
-----------
https://github.com/krylosov-aa/pg-status
EOF

RUN tar -czvf /pg-status_1.6.1_linux_amd64_static.tar.gz \
    pg-status \
    LICENSE \
    THIRD-PARTY-NOTICES \
    README \
    licenses/

# -------- Export --------
FROM scratch AS export
COPY --from=packager /pg-status_1.6.1_linux_amd64_static.tar.gz /

# -------- Run --------
FROM ubuntu:latest AS runner
WORKDIR /app

COPY --from=builder /app/build/src/pg-status /app/pg-status

ENTRYPOINT ["/app/pg-status"]
