# -------- Build --------
FROM ubuntu:24.04 AS builder

ARG CJSON_VERSION=1.7.19
ARG CJSON_SHA256=7fa616e3046edfa7a28a32d5f9eacfd23f92900fe1f8ccd988c1662f30454562
ARG OPENSSL_VERSION=3.5.7
ARG OPENSSL_SHA256=a8c0d28a529ca480f9f36cf5792e2cd21984552a3c8e4aa11a24aa31aeac98e8
ARG POSTGRESQL_VERSION=18.6
ARG POSTGRESQL_SHA256=983ee554ec53dbeb9b70797bef9fcf4e67e117e7e48ca1463cc80b3ff8e8ff3f

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash clang clang-tools build-essential cmake ninja-build pkg-config libtool \
    autoconf automake tar curl \
    zlib1g-dev libssl-dev libicu-dev bison flex ca-certificates \
    libevent-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp

RUN cp /usr/share/doc/libevent-dev/copyright /tmp/LICENSE-libevent

# ---- cJSON ----
RUN curl -fSLO "https://github.com/DaveGamble/cJSON/archive/refs/tags/v${CJSON_VERSION}.tar.gz" && \
    echo "${CJSON_SHA256}  v${CJSON_VERSION}.tar.gz" | sha256sum -c - && \
    tar xf "v${CJSON_VERSION}.tar.gz" && \
    cd "cJSON-${CJSON_VERSION}" && \
    sed -i '/cmake_minimum_required/d' CMakeLists.txt && \
    sed -i '1i cmake_minimum_required(VERSION 3.10)' CMakeLists.txt && \
    cmake -B build -G Ninja \
        -DENABLE_CJSON_TEST=OFF \
        -DBUILD_SHARED_LIBS=OFF \
        -DCMAKE_BUILD_TYPE=Release . && \
    cmake --build build --target install && \
    cp LICENSE /tmp/LICENSE-cJSON

# ---- OpenSSL ----
RUN curl -fSLO "https://www.openssl.org/source/openssl-${OPENSSL_VERSION}.tar.gz" && \
    echo "${OPENSSL_SHA256}  openssl-${OPENSSL_VERSION}.tar.gz" | sha256sum -c - && \
    tar xf "openssl-${OPENSSL_VERSION}.tar.gz" && \
    cd "openssl-${OPENSSL_VERSION}" && \
    env CC=gcc ./config no-shared no-dso no-tests \
        --prefix=/usr/local --libdir=lib && \
    make -j$(nproc) && make install_sw && \
    cp LICENSE.txt /tmp/LICENSE-OpenSSL

# ---- libpq ----
RUN curl -fSLO "https://ftp.postgresql.org/pub/source/v${POSTGRESQL_VERSION}/postgresql-${POSTGRESQL_VERSION}.tar.gz" && \
    echo "${POSTGRESQL_SHA256}  postgresql-${POSTGRESQL_VERSION}.tar.gz" | sha256sum -c - && \
    tar xf "postgresql-${POSTGRESQL_VERSION}.tar.gz" && \
    cd "postgresql-${POSTGRESQL_VERSION}" && \
    ./configure --prefix=/usr/local --without-readline --with-openssl --without-icu CFLAGS="-O2" && \
    make -C src/common && make -C src/port && make -C src/interfaces/libpq && \
    ar rcs src/common/libpgcommon.a src/common/*.o && \
    ar rcs src/port/libpgport.a src/port/*.o && \
    cp src/common/libpgcommon.a src/port/libpgport.a /usr/local/lib && \
    make -C src/interfaces/libpq install && \
    mkdir -p /usr/local/include/postgresql && \
    cp src/interfaces/libpq/libpq-fe.h src/include/postgres_ext.h \
       src/include/libpq/pqcomm.h \
       src/include/libpq/libpq-fs.h \
       /usr/local/include/postgresql/ && \
    cp COPYRIGHT /tmp/LICENSE-PostgreSQL

# ---- zlib license ----
COPY docker/ubuntu/package/zlib-license.txt /tmp/LICENSE-zlib

# ---- Build app ----
WORKDIR /app

COPY CMakeLists.txt .
COPY src/ src/
COPY test/CMakeLists.txt test/
COPY test/tests/ test/tests/

ENV CC=clang
ENV CFLAGS="-static -O2"

RUN cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=OFF \
        -DPG_STATUS_STATIC_DEPENDENCIES=ON \
        -DPG_STATUS_LINK_WARNINGS_AS_ERRORS=OFF \
        -DCMAKE_EXE_LINKER_FLAGS="-static" \
        -DCMAKE_SHARED_LIBRARY_LINK_C_FLAGS="" \
        -DCMAKE_FIND_LIBRARY_SUFFIXES=".a" \
        -DCMAKE_PREFIX_PATH="/usr/local" \
        -DLIBPQ_INCLUDE_DIR="/usr/local/include/postgresql" \
        -DLIBPQ_LIBRARY="/usr/local/lib/libpq.a;/usr/local/lib/libpgcommon.a;/usr/local/lib/libpgport.a;/usr/local/lib/libssl.a;/usr/local/lib/libcrypto.a;m;z;dl" \
        . && \
    cmake --build build && \
    ctest --test-dir build --output-on-failure

# -------- Package Archive --------
FROM ubuntu:24.04 AS packager

RUN apt-get update && apt-get install -y --no-install-recommends tar gzip && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /archive

COPY --from=builder /app/build/src/pg-status pg-status
COPY --from=builder /tmp/LICENSE-libevent licenses/LICENSE-libevent
COPY --from=builder /tmp/LICENSE-cJSON licenses/LICENSE-cJSON
COPY --from=builder /tmp/LICENSE-OpenSSL licenses/LICENSE-OpenSSL
COPY --from=builder /tmp/LICENSE-PostgreSQL licenses/LICENSE-PostgreSQL
COPY --from=builder /tmp/LICENSE-zlib licenses/LICENSE-zlib
COPY LICENSE LICENSE
COPY docker/ubuntu/package/static-third-party-notices.txt THIRD-PARTY-NOTICES
COPY docker/ubuntu/package/static-readme.txt README

RUN architecture="$(dpkg --print-architecture)" && \
    tar -czvf "/pg-status_2.1.1_linux_${architecture}_static.tar.gz" \
        pg-status \
        LICENSE \
        THIRD-PARTY-NOTICES \
        README \
        licenses/

# -------- Export --------
FROM scratch AS export
COPY --from=packager /pg-status_2.1.1_linux_*_static.tar.gz /

# -------- Run --------
FROM ubuntu:24.04 AS runner

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/build/src/pg-status /app/pg-status

ENTRYPOINT ["/app/pg-status"]
