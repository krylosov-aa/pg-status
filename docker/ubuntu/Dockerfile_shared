# Создаём архив
RUN apt-get update && apt-get install -y --no-install-recommends tar gzip && \
    rm -rf /var/lib/apt/lists/*

RUN tar -czvf /pg-status_2.1.0_linux_amd64_shared.tar.gz \
    pg-status \
    LICENSE \
    THIRD-PARTY-NOTICES \
    README

# -------- Export --------
FROM scratch AS export
COPY --from=packager /pg-status_2.1.0_linux_amd64_shared.tar.gz /

# -------- Run --------
FROM ubuntu:latest AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libmicrohttpd12 \
    libcjson1 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/build/src/pg-status /app/pg-status

ENTRYPOINT ["/app/pg-status"]
